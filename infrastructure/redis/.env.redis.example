# Redis Infrastructure Environment Variables
# Copy this file to .env.redis and configure for your environment

# ============================================================================
# REDIS MASTER CONFIGURATION
# ============================================================================

# Redis password (REQUIRED for production)
REDIS_PASSWORD=your_secure_redis_password_here

# Redis master host (default: redis-master for Docker)
REDIS_HOST=redis-master
REDIS_PORT=6379
REDIS_DB=0

# ============================================================================
# REDIS SENTINEL CONFIGURATION (High Availability)
# ============================================================================

# Enable Sentinel mode for HA
REDIS_USE_SENTINEL=true

# Sentinel master name
REDIS_SENTINEL_MASTER=bhriguwelt-master

# Sentinel hosts (comma-separated)
REDIS_SENTINEL_HOSTS=localhost:26379,localhost:26380,localhost:26381

# Sentinel IP for Docker (leave empty for auto-detect)
SENTINEL_IP=

# ============================================================================
# REDIS CONNECTION CONFIGURATION
# ============================================================================

# Maximum connections in pool
REDIS_MAX_CONNECTIONS=50

# Connection timeouts (seconds)
REDIS_SOCKET_TIMEOUT=5.0
REDIS_CONNECT_TIMEOUT=5.0

# Default TTL for cached items (seconds)
REDIS_DEFAULT_TTL=3600

# Health check interval (seconds)
REDIS_HEALTH_CHECK_INTERVAL=30

# ============================================================================
# REDIS MONITORING CONFIGURATION
# ============================================================================

# Enable Redis monitoring
ENABLE_REDIS_MONITORING=true

# Alert thresholds
REDIS_ALERT_CONNECTION_FAILURES=5
REDIS_ALERT_MEMORY_PERCENT=80
REDIS_ALERT_CPU_PERCENT=70
REDIS_ALERT_SLOW_QUERIES=10
REDIS_ALERT_RESPONSE_TIME=1000
REDIS_ALERT_HIT_RATE_MIN=70

# Maximum memory for Redis (MB)
REDIS_MAX_MEMORY_MB=512

# ============================================================================
# AI QUOTA CONFIGURATION
# ============================================================================

# Enable AI quota management
ENABLE_AI_QUOTA=true

# Default quota tier for new users
DEFAULT_QUOTA_TIER=free

# Quota limits (can be overridden per tier)
USER_DAILY_TOKEN_LIMIT=100000
USER_DAILY_REQUEST_LIMIT=50

# ============================================================================
# CACHING CONFIGURATION
# ============================================================================

# Enable Redis caching
ENABLE_CACHING=true

# Cache key prefix
CACHE_KEY_PREFIX=bhrigu

# ============================================================================
# CELERY CONFIGURATION (Task Queue)
# ============================================================================

# Celery broker URL (uses Redis)
CELERY_BROKER_URL=redis://:${REDIS_PASSWORD}@redis-master:6379/0

# Celery result backend
CELERY_RESULT_BACKEND=redis://:${REDIS_PASSWORD}@redis-master:6379/0

# ============================================================================
# DEPLOYMENT ENVIRONMENT
# ============================================================================

# Environment (development, staging, production)
ENVIRONMENT=production

# Application name
APP_NAME=bhriguwelt

# ============================================================================
# NOTES
# ============================================================================
#
# 1. Always use strong passwords for REDIS_PASSWORD in production
# 2. Enable REDIS_USE_SENTINEL=true for production HA setup
# 3. Adjust REDIS_MAX_CONNECTIONS based on your load
# 4. Monitor REDIS_ALERT_* thresholds and adjust as needed
# 5. Review quota limits based on your pricing model
#
# ============================================================================
