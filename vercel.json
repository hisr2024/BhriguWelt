{
  "version": 2,
  "env": {
    "NEXT_PUBLIC_BACKEND_URL": "https://your-render-service.onrender.com"
  },
  "installCommand": "npm install --workspaces --include-workspace-root=false",
  "buildCommand": "cd frontend && npm run build",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ]
}
