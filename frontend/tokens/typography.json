{
  "fonts": {
    "display": "Plus Jakarta Sans",
    "body": "Manrope",
    "ui": "Plus Jakarta Sans"
  },
  "scale": {
    "display": "clamp(2.8rem, 4vw, 3.6rem)",
    "h1": "clamp(2.2rem, 3vw, 2.8rem)",
    "h2": "clamp(1.8rem, 2.4vw, 2.2rem)",
    "h3": "clamp(1.5rem, 2vw, 1.8rem)",
    "h4": "1.35rem",
    "h5": "1.12rem",
    "body": "1rem",
    "microcopy": "0.9rem",
    "label": "0.85rem"
  },
  "weights": {
    "regular": 400,
    "medium": 500,
    "semibold": 600,
    "bold": 700
  },
  "letterSpacing": {
    "wordmark": "0.04em",
    "label": "0.08em"
  }
}
