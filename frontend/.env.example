# Frontend configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
# Optional: wire Sentry by providing a DSN and installing @sentry/nextjs
NEXT_PUBLIC_SENTRY_DSN=
# Optional: label telemetry environments (production, preview, staging)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
# Optional: tune sampling for performance traces/profiles
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0.0
# Optional: default language (en, hi, es, ta)
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
