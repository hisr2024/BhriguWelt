# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///bhriguwelt.db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# AI Configuration
AI_FEATURES_ENABLED=true
DAILY_AI_QUOTA=1000
MONTHLY_AI_QUOTA=30000

# CORS Settings
FRONTEND_URL=https://your-frontend-url.vercel.app

# Security Configuration
# CRITICAL: CSRF protection MUST be disabled for stateless API with CORS
# This app uses client-side encryption (no server sessions) + CORS protection
ENABLE_CSRF_PROTECTION=false

# ============================================================================
# Redis Configuration (for caching, quota management, and rate limiting)
# ============================================================================
# Enable/disable Redis features (set to false to run without Redis)
REDIS_ENABLED=true

# Redis connection URL (Render will provide internal URL in production)
REDIS_URL=redis://localhost:6379/0

# Redis connection pool settings
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# Redis circuit breaker settings (auto-disable on failures)
REDIS_CIRCUIT_BREAKER_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_TIMEOUT=60

# Mapbox Geocoding (optional - for location conversion)
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Request Size Configuration
MAX_REQUEST_BYTES=1048576
COMPRESSION_THRESHOLD_BYTES=65536

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# SendGrid Email Notification (optional)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@bhriguwelt.com

# Server Configuration
HOST=0.0.0.0
PORT=8000

# ============================================================================
# AI Quota Management
# ============================================================================
# Daily token limit per user (100K tokens = ~$0.20 at $0.002/1K)
USER_DAILY_TOKEN_LIMIT=100000

# OpenAI cost management
OPENAI_COST_PER_1K=0.002
PER_REQUEST_COST_LIMIT=1.0

# OpenAI JSON Response Format (force structured output)
OPENAI_USE_JSON_FORMAT=true

# OpenAI additional settings
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_RETRIES=3
OPENAI_TIMEOUT=90
OPENAI_BACKOFF_BASE=1
OPENAI_PROMPT_TOKEN_BUDGET=8000

# ============================================================================
# Core Wisdom Files Configuration
# ============================================================================
# Path to Bhrigu Samhita and Nadi Jyotisha wisdom files
# Leave empty to use auto-detection (tries multiple locations)
# Production (Render): /opt/render/project/src/core_wisdom
# Development: ./core_wisdom or ../core_wisdom
CORE_WISDOM_PATH=

# ============================================================================
# Production-specific Notes (Render.com)
# ============================================================================
# The following are automatically set by Render - shown here for reference:
# - PORT: Render sets this automatically (typically 10000)
# - REDIS_URL: Render provides internal Redis connection string
# - CORE_WISDOM_PATH: Set to /opt/render/project/src/core_wisdom in render.yaml
