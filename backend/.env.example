# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=your-secret-key-here-change-in-production

# Database
DATABASE_URL=sqlite:///bhriguwelt.db

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# AI Configuration
AI_FEATURES_ENABLED=true
DAILY_AI_QUOTA=1000
MONTHLY_AI_QUOTA=30000

# CORS Settings
FRONTEND_URL=https://your-frontend-url.vercel.app

# Security Configuration
# CRITICAL: CSRF protection MUST be disabled for stateless API with CORS
# This app uses client-side encryption (no server sessions) + CORS protection
ENABLE_CSRF_PROTECTION=false

# Redis (optional - for caching and rate limiting)
REDIS_URL=redis://localhost:6379/0

# Mapbox Geocoding (optional - for location conversion)
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Request Size Configuration
MAX_REQUEST_BYTES=1048576
COMPRESSION_THRESHOLD_BYTES=65536

# Sentry Error Tracking (optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Server Configuration
HOST=0.0.0.0
PORT=8000
