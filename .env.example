# ===========================================
# BhriguWelt Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit the actual .env file to version control

# ----- Backend Configuration -----
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# OpenAI API Key for AI features
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# ----- Frontend Configuration -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BhriguWelt
NEXT_PUBLIC_APP_DESCRIPTION=Discover Your Soul's Journey Through Vedic Astrology
NEXT_PUBLIC_API_TIMEOUT=120000

# CDN Configuration (optional - for production)
# Set this to your CDN URL (e.g., CloudFront, Cloudflare, Vercel)
# NEXT_PUBLIC_CDN_URL=https://cdn.bhriguwelt.com
# Or use CloudFront: https://d1234567890.cloudfront.net
# Or use Cloudflare: https://cdn.example.com

# ----- Database Configuration (if applicable) -----
# SQLite is used by default, but you can configure other databases
DATABASE_URL=sqlite:///./bhriguwelt.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/bhriguwelt

# ----- Redis Configuration (optional caching) -----
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
# Performance tuning
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5
REDIS_DEFAULT_TTL=3600

# ----- Monitoring and Observability (optional) -----
# Sentry for error tracking (both frontend and backend)
# Get your DSN from https://sentry.io
SENTRY_DSN=
# Optional: Set app version for Sentry release tracking
APP_VERSION=1.0.0
# Optional: Override environment for Sentry (defaults to FLASK_ENV)
# SENTRY_ENVIRONMENT=production

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ----- Security Settings -----
# CORS settings
CORS_ORIGINS=http://localhost:3000,https://bhriguwelt.vercel.app

# Session settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ----- Feature Flags -----
# Enable/disable specific features
ENABLE_AI_FEATURES=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ----- External Services -----
# Add any external service API keys here
# GOOGLE_MAPS_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ----- Development Settings -----
# Only for local development
FLASK_DEBUG=false
NEXT_TELEMETRY_DISABLED=1
