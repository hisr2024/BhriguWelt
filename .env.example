# ===========================================
# BhriguWelt Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Never commit the actual .env file to version control

# ----- Backend Configuration -----
FLASK_ENV=development
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-change-in-production

# OpenAI API Key for AI features
OPENAI_API_KEY=sk-your-openai-api-key

# ----- Frontend Configuration -----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=BhriguWelt
NEXT_PUBLIC_APP_DESCRIPTION=Discover Your Soul's Journey Through Vedic Astrology

# ----- Database Configuration (if applicable) -----
# SQLite is used by default, but you can configure other databases
DATABASE_URL=sqlite:///./bhriguwelt.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/bhriguwelt

# ----- Redis Configuration (optional caching) -----
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ----- Monitoring and Observability (optional) -----
# Sentry for error tracking
SENTRY_DSN=

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ----- Security Settings -----
# CORS settings
CORS_ORIGINS=http://localhost:3000,https://bhriguwelt.vercel.app

# Session settings
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ----- Feature Flags -----
# Enable/disable specific features
ENABLE_AI_FEATURES=true
ENABLE_CACHING=true
ENABLE_RATE_LIMITING=true

# ----- Rate Limiting -----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ----- External Services -----
# Add any external service API keys here
# GOOGLE_MAPS_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ----- Development Settings -----
# Only for local development
FLASK_DEBUG=false
NEXT_TELEMETRY_DISABLED=1
